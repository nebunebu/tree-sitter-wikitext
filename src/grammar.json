{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "wikitext",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_block_element"
      }
    },
    "_block_element": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "redirect"
        },
        {
          "type": "SYMBOL",
          "name": "heading"
        },
        {
          "type": "SYMBOL",
          "name": "list_item"
        },
        {
          "type": "SYMBOL",
          "name": "preformatted"
        },
        {
          "type": "SYMBOL",
          "name": "table"
        },
        {
          "type": "SYMBOL",
          "name": "horizontal_rule"
        },
        {
          "type": "SYMBOL",
          "name": "_inline_core"
        },
        {
          "type": "SYMBOL",
          "name": "_punct"
        },
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "_newline": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\r?\\n"
      }
    },
    "_sp": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[ \\t]+"
      }
    },
    "_tag_ws": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[ \\t\\r\\n]+"
      }
    },
    "_inline_core": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "template"
        },
        {
          "type": "SYMBOL",
          "name": "parameter"
        },
        {
          "type": "SYMBOL",
          "name": "parser_function"
        },
        {
          "type": "SYMBOL",
          "name": "wikilink"
        },
        {
          "type": "SYMBOL",
          "name": "external_link"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_auto_url"
          },
          "named": true,
          "value": "url"
        },
        {
          "type": "SYMBOL",
          "name": "magic_link"
        },
        {
          "type": "SYMBOL",
          "name": "bold"
        },
        {
          "type": "SYMBOL",
